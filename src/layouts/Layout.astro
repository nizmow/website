---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "nizmow's corner of the internet" } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
	{ href: base, label: 'Home' },
	{ href: `${base}blog/`, label: 'Blog' },
	{ href: `${base}notes/`, label: 'Notes' },
	{ href: `${base}projects/`, label: 'Projects' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				{
					nav.map((item) => (
						<a href={item.href} class:list={{ current: item.href === Astro.url.pathname }}>{item.label}</a>
					))
				}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>© {year} nizmow</footer>
	</body>
</html>

<style>
	:root {
		--text: #1a1a1a;
		--muted: #666;
		--accent: #0b5fff;
		--border: #e2e2e2;
		--bg: #ffffff;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--text: #e6e6e6;
			--muted: #9a9a9a;
			--accent: #7aa7ff;
			--border: #333;
			--bg: #151515;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--text);
		font-family:
			system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		line-height: 1.6;
	}

	header {
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 46rem;
		margin: 0 auto;
		padding: 0.75rem 1.25rem;
		display: flex;
		gap: 1.25rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover,
	nav a.current {
		color: var(--accent);
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
	}

	footer {
		border-top: 1px solid var(--border);
		padding: 1rem 1.25rem;
		text-align: center;
		color: var(--muted);
		font-size: 0.875rem;
	}

	/* Typography for rendered content (markdown bodies, home page, lists). */
	:global(.content) h1,
	:global(.content) h2,
	:global(.content) h3 {
		line-height: 1.25;
	}

	:global(.content) a {
		color: var(--accent);
	}

	:global(.content) pre {
		overflow-x: auto;
		padding: 0.75rem 1rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 6px;
	}

	:global(.content) code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.9em;
	}
</style>
