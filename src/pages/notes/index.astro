---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, sortByDate } from '../../lib/dates';

const base = import.meta.env.BASE_URL;
const notes = (await getCollection('notes')).sort(sortByDate);
---

<Layout title="Notes" description="Evergreen notes and reference lists by nizmow.">
	<section class="content">
		<h1>Notes</h1>
		{
			notes.length > 0 ? (
				<ul class="note-list">
					{
						notes.map(
							(note) => (
								<li>
									<div>
										<a href={`${base}notes/${note.id}/`}>{note.data.title}</a>
										{note.data.description && <p>{note.data.description}</p>}
										{note.data.tags.length > 0 && (
											<p class="tags">{note.data.tags.map((tag) => `#${tag}`).join(' ')}</p>
										)}
									</div>
									{note.data.date && (
										<time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
									)}
								</li>
							),
						)
					}
				</ul>
			) : (
				<p>No notes yet.</p>
			)
		}
	</section>
</Layout>

<style>
	.note-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.note-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border);
	}

	.note-list a {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
	}

	.note-list a:hover {
		color: var(--accent);
	}

	.note-list p {
		margin: 0.15rem 0 0;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.note-list .tags {
		font-size: 0.8rem;
		color: var(--accent);
	}

	.note-list time {
		color: var(--muted);
		font-size: 0.875rem;
		white-space: nowrap;
	}
</style>
